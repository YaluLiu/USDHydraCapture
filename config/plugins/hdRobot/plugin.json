{
  "name": "hdRobot",
  "renderer_plugin": "HdRobotRendererPlugin",
  "defaults": {
    "aovs": ["color", "tileDisplayColor","tileDisplayDepth","tileColor","tileDepth"],
    "maxIterations": 1,
    "settings": {
      "hdRobot:tile:enabled": true,
      "hdRobot:tile:cameraWidth": 1080,
      "hdRobot:tile:cameraHeight": 720,
      "hdRobot:tile:gridColumns": 10,
      "hdRobot:tile:gridRows": 10
    }
  },
  "aovs": {
    "color": {
      "output_ext": ".png"
    },
    "tileColor": {
      "output_ext": ".png"
    },
    "tileDisplayColor": {
      "output_ext": ".png"
    },
    "depth": {
      "output_ext": ".ppm"
    },
    "tileDepth": {
      "output_ext": ".ppm"
    },
    "tileDisplayDepth": {
      "output_ext": ".png"
    }
  }
}
